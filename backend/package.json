{
  "name": "server-node-express",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --detectOpenHandles",
    "test:watch": "jest --watch --runInBand --detectOpenHandles",
    "test:coverage": "jest --coverage --runInBand --detectOpenHandles",
    "hash-passwords": "node scripts/hashPasswords.js",
    "create-indexes": "node scripts/createIndexes.js",
    "import-data": "node scripts/importData.js",
    "import-students": "node scripts/importStudents.js",
    "update-student-emails": "node scripts/updateStudentEmails.js",
    "update-user-emails": "node scripts/updateUserEmails.js",
    "seed:seip": "node scripts/seedSeipExpenses.js",
    "generate-installment-dues": "node scripts/generateInstallmentDues.js",
    "check-budgets": "node scripts/checkBudgets.js",
    "create-test-budget": "node scripts/createTestBudget.js",
    "setup-production": "npm run hash-passwords && npm run create-indexes"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^2.4.3",
    "body-parser": "^2.2.0",
    "bullmq": "^5.78.1",
    "chalk": "^5.6.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "express": "^5.1.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.0",
    "express-validator": "^7.0.1",
    "google-auth-library": "^10.5.0",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.0",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "nodemailer": "^6.9.7",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "razorpay": "^2.9.6",
    "redis": "^6.0.0",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "xlsx": "^0.18.5",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "./tests/setup.js"
    ],
    "moduleNameMapper": {
      "^\\.\\./models/(.*)$": "<rootDir>/src/models/$1"
    },
    "testTimeout": 10000,
    "collectCoverageFrom": [
      "**/*.js",
      "!node_modules/**",
      "!coverage/**",
      "!tests/**",
      "!scripts/**"
    ]
  }
}
